<body class="stories-page">

    <header>
        <nav class="navbar">
            <a href="/" class="logo">SPIRIT//<span>STORY</span></a>
            <ul class="nav-links">
                <li><a href="/stories">STORIE</a></li>
                <li><a href="/shop">SHOP</a></li>
