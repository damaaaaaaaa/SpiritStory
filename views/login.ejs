<%- include('header', { bodyClass: 'login-page' }); -%>

    <main class="login-layout">
        <div class="login-container">
            <div class="login-header">
                <h2>LOG_IN // SISTEMA</h2>
                <p class="login-status">[ STATO: ACCESSO RICHIESTO ]</p>
            </div>
            <form class="login-form" action="/login" method="POST">
                <div class="input-box">
                    <label>ID_UTENTE // EMAIL</label>
                    <input type="email" name="email" placeholder="NOME@EMAIL.COM" required>
                </div>
                <div class="input-box">
                    <label>CHIAVE_ACCESSO // PASSWORD</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-submit-auth">ACCEDI AL SISTEMA_</button>
            </form>
            <div class="login-register-footer">
                <span>NON HAI UN ACCOUNT?</span>
                <a href="/register" class="register-link">REGISTRATI // JOIN THE CREW</a>
            </div>
        </div>
    </main>

<%- include('footer'); -%>