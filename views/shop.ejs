<%- include('header', { bodyClass: 'shop-page' }); -%>
<% 
    const safeFilters = locals.filters || {};
    const safeProducts = locals.products || [];
%>

    <main class="shop-layout">
        <!-- SIDEBAR FILTRI -->
        <form action="/shop" method="GET" class="filters-sidebar">
            <h2 class="sidebar-title">FILTRI_SISTEMA</h2>
            <div class="filter-group">
                <h3>CATEGORIA</h3>
                <label class="container-check">DISTILLATI (WHISKEY)
                    <input type="radio" name="category" value="distillato" <%= safeFilters.category === 'distillato' ? 'checked' : '' %>>
                    <span class="checkmark"></span>
                </label>
                <label class="container-check">BIRRE ARTIGIANALI
                    <input type="radio" name="category" value="birra" <%= safeFilters.category === 'birra' ? 'checked' : '' %>>
                    <span class="checkmark"></span>
                </label>
                <label class="container-check">MOSTRA TUTTO
                    <input type="radio" name="category" value="all" <%= (!safeFilters.category || safeFilters.category === 'all') ? 'checked' : '' %>>
                    <span class="checkmark"></span>
                </label>
            </div>

            <div class="filter-group">
                <h3>ORDINA PER</h3>
                <select name="sort" class="filter-select">
                    <option value="newest" <%= safeFilters.sort === 'newest' ? 'selected' : '' %>>ULTIMI DROP</option>
                    <option value="price_asc" <%= safeFilters.sort === 'price_asc' ? 'selected' : '' %>>PREZZO: LOW-HIGH</option>
                    <option value="price_desc" <%= safeFilters.sort === 'price_desc' ? 'selected' : '' %>>PREZZO: HIGH-LOW</option>
                </select>
            </div>
            <button type="submit" class="btn-apply-filters">APPLICA SETTAGGI</button>
        </form>

        <!-- CATALOGO PRODOTTI -->
        <section class="catalog-container">
            <div class="catalog-header">
                <span>RISULTATI TROVATI: [<%= safeProducts.length %>]</span>
            </div>
            <div class="product-grid">
                <% safeProducts.forEach(function(prod) { %>
                    <div class="product-card">
                        <div class="card-image">
                            <a href="/product/<%= prod.id %>">
                                <img src="<%= prod.image %>" alt="<%= prod.name %>">
                            </a>
                            <form action="/cart/add/<%= prod.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="quick-add">+ AGGIUNGI</button>
                            </form>
                        </div>
                        <div class="card-info">
                            <p class="brand"><%= prod.brand %></p>
                            <h4 class="product-name"><%= prod.name %></h4>
                            <div class="price-row">
                                <span class="price">€ <%= Number(prod.price).toFixed(2) %></span>
                                <a href="/product/<%= prod.id %>" class="view-detail">DETTAGLI</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

<%- include('footer'); -%>