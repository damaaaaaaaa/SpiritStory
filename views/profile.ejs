<%- include('header', { bodyClass: 'profile-page' }); -%>
    <main style="max-width: 900px; margin: 4rem auto; padding: 2rem;">
        
        <h1 style="color: var(--brand-neon); margin-bottom: 2rem;">PROFILO_UTENTE // <%= user.username %></h1>
        
        <div style="background: var(--bg-surface); padding: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--border-light); margin-bottom: 3rem;">
            <h3 style="margin-bottom: 1.5rem; color: var(--text-muted);">DATI ACCESSO</h3>
            <p><strong>USER_ID:</strong> <%= user.id %></p>
            <p><strong>NOME:</strong> <%= user.username %></p>
            <p><strong>EMAIL:</strong> <%= user.email %></p>
            <p><strong>LIVELLO ACCESSO:</strong> <span style="color: <%= user.role === 'admin' ? 'var(--brand-neon)' : 'white' %>"><%= user.role.toUpperCase() %></span></p>
        </div>

        <h2 style="margin-bottom: 1.5rem;">STORICO ORDINI</h2>
        <% if (locals.orders && orders.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <% orders.forEach(function(order) { %>
                    <div style="background: var(--bg-elevated); padding: 1.5rem; border-radius: var(--radius-md); border-left: 4px solid var(--brand-neon); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <p style="font-weight: 900; margin-bottom: 5px;">ORDINE #SYS-<%= order.id %>-2026</p>
                            <p style="font-size: 0.85rem; color: var(--text-muted);">Data: <%= new Date(order.date).toLocaleDateString('it-IT') %></p>
                        </div>
                        <div style="text-align: right;">
                            <p style="font-size: 1.2rem; font-weight: 900; color: white;">€<%= Number(order.total).toFixed(2) %></p>
                            <p style="font-size: 0.8rem; font-weight: 900; color: <%= order.status === 'Spedito' ? 'var(--brand-neon)' : 'orange' %>;"><%= order.status.toUpperCase() %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p style="color: var(--text-muted);">Nessun ordine effettuato. <a href="/shop" style="color: var(--brand-neon);">Vai allo shop.</a></p>
        <% } %>
    </main>
<%- include('footer'); -%>