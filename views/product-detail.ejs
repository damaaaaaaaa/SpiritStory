<%- include('header', { bodyClass: 'product-page' }); -%>
<% 
  const product = locals.product || {};
  const reviews = locals.reviews || [];
  const user = locals.user || null;
%>

    <main class="product-detail-layout">
        <% if (product.id) { %>
            <section class="product-gallery">
                <div class="main-image-container">
                    <span class="detail-tag-limited"><%= product.category === 'birra' ? 'CRAFT DROP' : 'LEGACY DROP' %></span>
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                </div>
                <div class="image-thumbnails">
                    <div class="thumb active"><img src="<%= product.image %>" alt="Front"></div>
                    <div class="thumb"><img src="<%= product.image %>" alt="Detail" style="transform: scale(1.5);"></div>
                    <div class="thumb"><img src="<%= product.image %>" alt="Back" style="filter: brightness(0.5);"></div>
                </div>
            </section>

            <section class="product-info-panel">
                <div class="product-meta">
                    <p class="product-brand-link"><%= product.brand %></p>
                    <h1 class="product-main-title"><%= product.name %></h1>
                    <p class="product-serial">SYS_REF: #ID-<%= product.id %>-2026</p>
                </div>

                <div class="product-price-box">
                    <span class="current-price">€<%= Number(product.price).toFixed(2) %></span>
                    <span class="availability-status">[ DISPONIBILITÀ: ALTA ]</span>
                </div>

                <div class="product-description">
                    <p class="desc-highlight">La storia in una bottiglia.</p>
                    <p class="desc-text"><%= product.story %></p>
                    
                    <h3 style="margin-top: 20px; color: var(--text-main); font-size: 0.9rem;">Drink Tips</h3>
                    <p class="desc-text"><%= product.drink_tips %></p>
                </div>

                <form action="/cart/add/<%= product.id %>" method="POST" class="purchase-actions">
                    <div class="quantity-selector">
                        <input type="number" name="quantity" value="1" min="1" max="10">
                    </div>
                    <button type="submit" class="btn-add-to-bag">AGGIUNGI ALLA BAG</button>
                </form>

                <div class="technical-specs">
                    <h3 class="specs-title">RECENSIONI COMMUNITY</h3>
                    <% if (reviews.length > 0) { %>
                        <div style="background: var(--bg-surface); padding: 15px; border-radius: var(--radius-md); margin-bottom: 20px; border: 1px solid var(--border-light);">
                            <% reviews.forEach(function(rev) { %>
                                <div style="margin-bottom: 15px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px;">
                                    <strong style="color: var(--brand-neon);"><%= rev.username %></strong> 
                                    <span style="color: gold; font-size: 0.8rem;">(Voto: <%= rev.rating %>/5)</span>
                                    <p style="color: var(--text-muted); margin-top: 5px; font-size: 0.9em;"><%= rev.comment %></p>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p style="color: var(--text-muted); margin-bottom: 20px;">Ancora nessuna recensione.</p>
                    <% } %>

                    <% if (user && user.role === 'user') { %>
                        <h4 style="margin-bottom: 10px; font-size: 0.8rem;">Lascia il tuo feedback</h4>
                        <form action="/product/<%= product.id %>/review" method="POST" style="display: flex; flex-direction: column; gap: 10px;">
                            <select name="rating" style="padding: 10px; background: var(--bg-elevated); color: white; border: 1px solid var(--border-focus); border-radius: var(--radius-sm);">
                                <option value="5">5 Stelle (Hype Totale)</option>
                                <option value="4">4 Stelle (Ottimo)</option>
                                <option value="3">3 Stelle (Buono)</option>
                                <option value="2">2 Stelle (Mediocre)</option>
                                <option value="1">1 Stella (Skip)</option>
                            </select>
                            <textarea name="comment" rows="3" placeholder="Cosa ne pensi?" style="padding: 10px; background: var(--bg-elevated); color: white; border: 1px solid var(--border-focus); border-radius: var(--radius-sm);"></textarea>
                            <button type="submit" class="btn-primary" style="padding: 10px;">INVIA</button>
                        </form>
                    <% } else if (!user) { %>
                        <p><a href="/login" style="color: var(--brand-neon); text-decoration: underline;">Fai Log In</a> per lasciare una recensione.</p>
                    <% } %>
                </div>
            </section>
        <% } else { %>
            <div style="padding: 100px; text-align: center;">
                <h1>PRODOTTO NON TROVATO</h1>
                <a href="/shop" class="btn-outline">TORNA ALLO SHOP</a>
            </div>
        <% } %>
    </main>

<%- include('footer'); -%>